!macro customWelcomePage
  !define MUI_WELCOMEPAGE_TITLE "A little more possibility."
  !define MUI_WELCOMEPAGE_TEXT "Welcome to download.net by Nuttyinc.$\r$\n$\r$\nIndependent games. Useful apps. One place to bring them home.$\r$\n$\r$\nThis wizard installs download.net and its Nuttyinc backend for your Windows account. Nuttyinc starts and connects automatically when you open the launcher. You can choose where it lives and whether to create a shortcut.$\r$\n$\r$\nClick Next to read the MIT license and get started."
  !insertmacro MUI_PAGE_WELCOME
!macroend
